{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32 (ST-Link)",
      "cwd": "${fileDirname}",
      "executable": "${fileDirname}/blink.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "preLaunchTask": "make debug"
    }
  ]
}